# Generate locally: python3 scripts/setup.py
# Published application image used by API and worker containers.
LIBRIS_IMAGE=heartbtz/libris:0.4.0
SECRET_KEY=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
POSTGRES_PASSWORD=
BIND_ADDRESS=127.0.0.1
PORT=8088
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
COOKIE_SECURE=true
SESSION_DURATION_HOURS=24
OPENVIKING_URL=
OPENVIKING_API_KEY=
OPENVIKING_ROOT_URI=viking://resources/epub-translator
CODEX_BRIDGE_TOKEN=
CODEX_BRIDGE_URL=http://codex:8092
# Final AI review is enabled for full-book translations. Web lookup is opt-in.
FINAL_REVIEW_ENABLED=true
SEARXNG_URL=
# Resource limits for imported archives.
MAX_UPLOAD_MB=60
MAX_UNPACKED_MB=300
MAX_ENTRIES=5000
# Advanced path overrides are normally only needed outside the supplied image.
# EPUBCHECK_JAR=
# FRONTEND_DIR=
# PROMPT_DIR=
# Behind a reverse proxy: address(es) of the trusted proxy, so that client addresses are read from X-Forwarded-For
# FORWARDED_ALLOW_IPS=172.18.0.1
