# Generate locally: python3 scripts/setup.py
# Published application image used by API and worker containers.
LIBRIS_IMAGE=heartbtz/libris:0.6.0
SECRET_KEY=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
POSTGRES_PASSWORD=
BIND_ADDRESS=127.0.0.1
PORT=8088
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
# Keep true: it works over HTTPS and on http://localhost / http://127.0.0.1 on the Libris machine itself.
# Set to false only if people open Libris over plain HTTP on a network address (http://192.168.1.10:8088,
# http://my-server:8088): the browser would drop the Secure session cookie and every login would seem to fail.
COOKIE_SECURE=true
SESSION_DURATION_HOURS=24
OPENVIKING_URL=
OPENVIKING_API_KEY=
OPENVIKING_ROOT_URI=viking://resources/epub-translator
# true: deleting a volume or a series also removes its OpenViking documents (done by the worker).
OPENVIKING_CLEANUP_ON_DELETE=false
CODEX_BRIDGE_TOKEN=
CODEX_BRIDGE_URL=http://codex:8092
# Final AI review is enabled for full-book translations. Web lookup is opt-in.
FINAL_REVIEW_ENABLED=true
SEARXNG_URL=
# Resource limits for imported archives.
MAX_UPLOAD_MB=60
MAX_UNPACKED_MB=300
MAX_ENTRIES=5000
MAX_COMPRESSION_RATIO=100
# Automation API (/api/v1, docs/api.md): JSON body per request (defaults to MAX_UPLOAD_MB),
# chapters per request, calls per token and per minute in each API process (0: no limit).
# API_MAX_PAYLOAD_MB=60
# API_MAX_CHAPTERS=2000
# API_RATE_LIMIT_PER_MINUTE=120
# Delivery: longest ?wait= long poll, minutes a request's job may stay paused/blocked/waiting and hours
# a request may live before it fails, EPUBCheck repair rounds of a delivered EPUB.
# API_RESULT_MAX_WAIT_SECONDS=60
# API_REQUEST_STALL_MINUTES=360
# API_REQUEST_MAX_HOURS=168
# DELIVERY_REPAIR_ATTEMPTS=3
# Webhooks (off while API_WEBHOOK_HOSTS is empty): allowed hosts (host or *.domain), private networks
# allowed anyway (CIDRs), global HMAC secret (32+ characters; a token's own secret wins).
# API_WEBHOOK_HOSTS=
# API_WEBHOOK_PRIVATE_NETWORKS=
# API_WEBHOOK_SECRET=
# API_WEBHOOK_MAX_ATTEMPTS=6
# API_WEBHOOK_TIMEOUT_SECONDS=10
# Fair queue (docs/configuration.md#fair-queue): jobs of one account running at once and waiting their
# turn (0: no limit; over the waiting quota, new jobs get HTTP 429), minutes of waiting that raise a
# job's priority by one level (0: never). Settings › Queue overrides them.
# QUEUE_MAX_RUNNING_PER_ACCOUNT=0
# QUEUE_MAX_QUEUED_PER_ACCOUNT=0
# QUEUE_PRIORITY_AGING_MINUTES=60
# Guided import: ask a person to confirm numbers guessed with low confidence (default: accept, recorded).
# IMPORT_CONFIRM_LOW_CONFIDENCE=false
# Live progress connections per account and per API process; memory for chapter previews.
# EVENT_STREAMS_PER_USER=4
# EVENT_STREAMS_TOTAL=100
# PREVIEW_CACHE_MB=64
# API description for signed-in users at /openapi.json; set to false to remove it.
# OPENAPI_ENABLED=true
# Advanced path overrides are normally only needed outside the supplied image.
# EPUBCHECK_JAR=
# FRONTEND_DIR=
# PROMPT_DIR=
# Prometheus scrape token for GET /metrics (at least 24 characters); empty disables the endpoint.
METRICS_TOKEN=
# Behind a reverse proxy: address(es) of the trusted proxy, so that client addresses are read from X-Forwarded-For
# FORWARDED_ALLOW_IPS=172.18.0.1
