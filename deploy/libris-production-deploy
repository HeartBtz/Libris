#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

usage() {
	cat >&2 <<'USAGE'
Usage: libris-production-deploy COMMIT VERSION APP_IMAGE_ID CODEX_IMAGE_ID
       libris-production-deploy --rollback
       libris-production-deploy --prune-images [--dry-run]
       libris-production-deploy --check-compose
USAGE
	exit 64
}

base="${LIBRIS_PRODUCTION_BASE:-/opt/libris-production}"
compose_file="${LIBRIS_PRODUCTION_COMPOSE_FILE:-$base/docker-compose.yml}"
secret_env="${LIBRIS_PRODUCTION_SECRET_ENV:-/opt/epub-translator/.env}"
project="${LIBRIS_PRODUCTION_PROJECT:-epub-translator}"
health_url="${LIBRIS_PRODUCTION_HEALTH_URL:-http://192.168.1.116:8088/health}"
registry_repository="${LIBRIS_PRODUCTION_REGISTRY_REPOSITORY:-192.168.1.126:5050/dev/libris}"

# Every deployment leaves its images behind. Keep what can still be needed: the deployed images, the
# retained `previous-*` ones (the rollback target) and anything a container uses; remove the other
# Libris tags and the untagged pulls of the Libris registry repository. No other image, and no volume.
prune_images() {
	local dry_run="$1" reference id tag digest containers
	local -A keep=()
	for reference in libris-production:previous-api libris-production:previous-worker libris-codex-production:previous; do
		if id="$(docker image inspect --format '{{.Id}}' "$reference" 2>/dev/null)"; then keep["$id"]=1; fi
	done
	for reference in current-app-image-id current-codex-image-id; do
		if [[ -s "$base/$reference" ]]; then keep["$(<"$base/$reference")"]=1; fi
	done
	containers="$(docker ps --all --quiet --no-trunc)" || return 1
	for reference in $containers; do
		id="$(docker inspect --format '{{.Image}}' "$reference")" || return 1
		keep["$id"]=1
	done
	remove() {
		if [[ "$dry_run" == true ]]; then
			echo "Would remove $1"
		elif docker image rm "$1" >/dev/null; then
			echo "Removed $1"
		fi
	}
	while read -r reference id; do
		[[ -z "$reference" || -n "${keep[$id]:-}" ]] || remove "$reference"
	done < <(docker image ls --no-trunc --format '{{.Repository}}:{{.Tag}} {{.ID}}' libris-production
		docker image ls --no-trunc --format '{{.Repository}}:{{.Tag}} {{.ID}}' libris-codex-production)
	while read -r reference tag digest id; do
		[[ "$tag" == "<none>" && "$digest" == sha256:* && -z "${keep[$id]:-}" ]] || continue
		remove "$reference@$digest"
	done < <(docker image ls --no-trunc --digests --format '{{.Repository}} {{.Tag}} {{.Digest}} {{.ID}}' "$registry_repository")
}

# The Compose file is versioned with the application: every image carries the docker-compose.yml of
# its commit (/app/deploy/docker-compose.yml). Images older than 0.6 carry none (empty output).
shipped_compose() {
	docker run --rm --entrypoint cat "$1" /app/deploy/docker-compose.yml 2>/dev/null || true
}

# Exit 0 when the installed Compose file is the deployed version's, 1 with the difference otherwise.
check_compose() {
	local deployed shipped
	[[ -s "$base/current-app-image-id" ]] || { echo "No deployed image is recorded in $base" >&2; exit 65; }
	deployed="$(<"$base/current-app-image-id")"
	shipped="$(mktemp)"
	shipped_compose "$deployed" > "$shipped"
	if [[ ! -s "$shipped" ]]; then
		rm -f "$shipped"
		echo "The deployed image carries no Compose file (older than 0.6): nothing to compare." >&2
		exit 0
	fi
	if cmp -s "$shipped" "$compose_file"; then
		rm -f "$shipped"
		echo "$compose_file is the deployed version's."
		exit 0
	fi
	echo "Drift: $compose_file differs from the deployed version's Compose file:"
	diff -u "$compose_file" "$shipped" || true
	rm -f "$shipped"
	exit 1
}

mode=deploy
case "${1:-}" in
--rollback)
	[[ $# -eq 1 ]] || usage
	mode=rollback
	;;
--prune-images)
	[[ $# -eq 1 || ( $# -eq 2 && "$2" == --dry-run ) ]] || usage
	prune_images "$([[ "${2:-}" == --dry-run ]] && echo true || echo false)"
	exit 0
	;;
--check-compose)
	[[ $# -eq 1 ]] || usage
	[[ -r "$compose_file" ]] || { echo "Production configuration is not provisioned" >&2; exit 65; }
	check_compose
	;;
*)
	[[ $# -eq 4 ]] || usage
	commit="$1"
	version="$2"
	expected_app_id="$3"
	expected_codex_id="$4"
	[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid commit" >&2; exit 64; }
	[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Invalid version" >&2; exit 64; }
	;;
esac

[[ -r "$compose_file" && -r "$secret_env" ]] || { echo "Production configuration is not provisioned" >&2; exit 65; }
if [[ "$mode" == rollback ]]; then
	# The target is what the last deployment replaced: the images it tagged `previous-*`.
	expected_app_id="$(docker image inspect --format '{{.Id}}' libris-production:previous-api 2>/dev/null)" \
		|| { echo "No previous application image is retained on this host: nothing to roll back to" >&2; exit 65; }
	expected_codex_id="$(docker image inspect --format '{{.Id}}' libris-codex-production:previous 2>/dev/null)" \
		|| { echo "No previous Codex image is retained on this host: nothing to roll back to" >&2; exit 65; }
	commit="$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$expected_app_id")"
	version="$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.version" }}' "$expected_app_id")"
	[[ "$commit" =~ ^[0-9a-f]{40}$ && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
		|| { echo "The previous image carries no valid version and revision labels" >&2; exit 65; }
fi
app_image="libris-production:$commit"
codex_image="libris-codex-production:$commit"
deployed_version=""
deployed_commit=""
if [[ -r "$base/current-version" ]]; then
	deployed_version="$(<"$base/current-version")"
	[[ ! -r "$base/current-commit" ]] || deployed_commit="$(<"$base/current-commit")"
fi
if [[ "$mode" == rollback ]]; then
	[[ -n "$deployed_version" ]] || { echo "No deployed version is recorded in $base: refusing a blind rollback" >&2; exit 65; }
	# Only ever backwards: once rolled back, `previous-*` designate the removed version.
	if [[ "$version" == "$deployed_version" || "$(printf '%s\n%s\n' "$deployed_version" "$version" | sort -V | tail -n 1)" == "$version" ]]; then
		echo "The retained previous version $version is not older than the deployed $deployed_version: nothing to roll back to" >&2
		exit 65
	fi
	docker image tag "$expected_app_id" "$app_image"
	docker image tag "$expected_codex_id" "$codex_image"
elif [[ -n "$deployed_version" ]]; then
	if [[ "$version" == "$deployed_version" && -n "$deployed_commit" && "$commit" != "$deployed_commit" ]]; then
		echo "Version $version is already associated with another commit" >&2
		exit 65
	fi
	if [[ "$version" != "$deployed_version" && "$(printf '%s\n%s\n' "$deployed_version" "$version" | sort -V | tail -n 1)" != "$version" ]]; then
		echo "Refusing outdated deployment $version after $deployed_version (use --rollback to return to the previous version)" >&2
		exit 65
	fi
fi
[[ "$(docker image inspect --format '{{.Id}}' "$app_image")" == "$expected_app_id" ]] || { echo "Application image changed" >&2; exit 65; }
[[ "$(docker image inspect --format '{{.Id}}' "$codex_image")" == "$expected_codex_id" ]] || { echo "Codex image changed" >&2; exit 65; }
for image in "$app_image" "$codex_image"; do
	[[ "$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image")" == "$commit" ]] || { echo "Image revision mismatch" >&2; exit 65; }
	[[ "$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.version" }}' "$image")" == "$version" ]] || { echo "Image version mismatch" >&2; exit 65; }
done

# The Compose file of the version being deployed replaces the installed one once the services are
# stopped; a drifted file is reported and kept next to it, and put back if the images are restored.
new_compose="$(mktemp)"
shipped_compose "$app_image" > "$new_compose"
compose_backup="$compose_file.before-$version"
compose_replaced=false
if [[ ! -s "$new_compose" ]]; then
	echo "Warning: $app_image carries no Compose file (older than 0.6): $compose_file is kept as it is." >&2
	rm -f "$new_compose"
	new_compose=""
elif cmp -s "$new_compose" "$compose_file"; then
	rm -f "$new_compose"
	new_compose=""
else
	echo "The installed $compose_file differs from the Compose file of $version; it will be replaced:"
	diff -u "$compose_file" "$new_compose" || true
fi

export LIBRIS_IMAGE="$app_image"
export LIBRIS_CODEX_IMAGE="$codex_image"
export LIBRIS_ENV_FILE="$secret_env"
compose=(docker compose --project-name "$project" --env-file "$secret_env" --file "$compose_file")
if [[ -n "${LIBRIS_PRODUCTION_COMPOSE_OVERRIDE:-}" ]]; then
	compose+=(--file "$LIBRIS_PRODUCTION_COMPOSE_OVERRIDE")
fi
compose+=(--profile codex)
# Stopped containers count: services are left stopped while a pre-deployment dump is being restored.
api_container="$("${compose[@]}" ps --all -q api)"
worker_container="$("${compose[@]}" ps --all -q worker)"
codex_container="$("${compose[@]}" ps --all -q codex)"
[[ -n "$api_container" ]] || { echo "Existing production API was not found" >&2; exit 65; }
[[ -n "$worker_container" ]] || { echo "Existing production worker was not found" >&2; exit 65; }
current_revision="$("${compose[@]}" exec -T database sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SELECT version_num FROM alembic_version ORDER BY version_num;"')"
target_revision="$(docker run --rm --entrypoint sh "$app_image" -lc "alembic heads | sed -n 's/ .*//p'")"
[[ -n "$current_revision" && -n "$target_revision" ]] || { echo "Could not resolve database revisions" >&2; exit 65; }
if [[ "$mode" == rollback && "$current_revision" != "$target_revision" ]]; then
	echo "The database schema ($current_revision) is not the one $version expects ($target_revision): the images alone cannot be rolled back." >&2
	echo "Nothing was changed. Restore the pre-deployment dump instead (docs/development.md, Rollback)." >&2
	exit 65
fi
check_health() {
	python3 - "$version" "$health_url" <<'PY'
import json
import sys
import urllib.request

with urllib.request.urlopen(sys.argv[2], timeout=5) as response:
    health = json.load(response)
if health != {"status": "ok", "version": sys.argv[1]}:
    raise SystemExit(f"Unexpected health response: {health}")
PY
}
if [[ "$version" == "$deployed_version" && "$commit" == "$deployed_commit" && -n "$codex_container" ]] \
	&& [[ "$(docker inspect --format '{{.Image}}' "$api_container")" == "$expected_app_id" ]] \
	&& [[ "$(docker inspect --format '{{.Image}}' "$worker_container")" == "$expected_app_id" ]] \
	&& [[ "$(docker inspect --format '{{.Image}}' "$codex_container")" == "$expected_codex_id" ]] \
	&& [[ "$(docker inspect --format '{{.State.Health.Status}}' "$api_container")" == healthy ]] \
	&& [[ "$(docker inspect --format '{{.State.Status}}' "$worker_container")" == running ]] \
	&& [[ "$(docker inspect --format '{{.State.Health.Status}}' "$codex_container")" == healthy ]] \
	&& [[ "$current_revision" == "$target_revision" ]] \
	&& [[ -z "$new_compose" ]] \
	&& check_health; then
	echo "Libris $version ($commit) is already deployed and healthy"
	exit 0
fi
previous_app_id="$(docker inspect --format '{{.Image}}' "$api_container")"
previous_worker_id="$(docker inspect --format '{{.Image}}' "$worker_container")"
previous_codex_id=""
[[ -z "$codex_container" ]] || previous_codex_id="$(docker inspect --format '{{.Image}}' "$codex_container")"
docker image tag "$previous_app_id" libris-production:previous-api
docker image tag "$previous_worker_id" libris-production:previous-worker
[[ -z "$previous_codex_id" ]] || docker image tag "$previous_codex_id" libris-codex-production:previous

install -d -m 0700 "$base/backups"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup="$(mktemp "$base/backups/pre-${timestamp}-${commit}.XXXXXX.dump")"
chmod 0600 "$backup"
schema_unchanged=true
services_stopped=false
migration_started=false

rollback() {
	status="${1:-$?}"
	trap - ERR INT TERM
	if [[ "$services_stopped" == false ]]; then
		rm -f "$backup" "$new_compose"
		echo "Deployment failed before service interruption; production remains online." >&2
		exit "$status"
	fi
	stop_succeeded=true
	"${compose[@]}" stop migrate api worker codex >/dev/null 2>&1 || stop_succeeded=false
	if [[ "$migration_started" == true ]]; then
		schema_unchanged=false
		migrate_container="$("${compose[@]}" ps -q --all migrate 2>/dev/null || true)"
		migrate_running="$(docker inspect --format '{{.State.Running}}' "$migrate_container" 2>/dev/null || true)"
		if [[ "$stop_succeeded" == true && "$migrate_running" != true ]]; then
			rollback_revision="$("${compose[@]}" exec -T database sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SELECT version_num FROM alembic_version ORDER BY version_num;"' 2>/dev/null || true)"
			[[ "$rollback_revision" != "$current_revision" ]] || schema_unchanged=true
		fi
	fi
	if [[ "$schema_unchanged" == true ]]; then
		if [[ "$compose_replaced" == true ]]; then
			# The previous images run with the Compose file they were deployed with.
			install -m 0600 "$compose_backup" "$compose_file"
		fi
		export LIBRIS_IMAGE=libris-production:previous-api
		services=(api)
		restore_failed=false
		if [[ -n "$previous_codex_id" ]]; then
			export LIBRIS_CODEX_IMAGE=libris-codex-production:previous
			services+=(codex)
		fi
		if ! "${compose[@]}" up -d --no-build --wait "${services[@]}"; then
			restore_failed=true
		else
			export LIBRIS_IMAGE=libris-production:previous-worker
			"${compose[@]}" up -d --no-build --no-deps --wait worker || restore_failed=true
		fi
		restored_app_id="$(docker inspect --format '{{.Image}}' "$("${compose[@]}" ps -q api)" 2>/dev/null || true)"
		restored_worker_id="$(docker inspect --format '{{.Image}}' "$("${compose[@]}" ps -q worker)" 2>/dev/null || true)"
		restored_codex_id=""
		[[ -z "$previous_codex_id" ]] || restored_codex_id="$(docker inspect --format '{{.Image}}' "$("${compose[@]}" ps -q codex)" 2>/dev/null || true)"
		if [[ "$restore_failed" == false && "$restored_app_id" == "$previous_app_id" && "$restored_worker_id" == "$previous_worker_id" && "$restored_codex_id" == "$previous_codex_id" ]]; then
			echo "Deployment failed; previous images restored because the schema was unchanged." >&2
		else
			echo "Deployment and automatic image restoration both failed; inspect CT116 immediately." >&2
			status=1
		fi
	else
		echo "Deployment failed after a schema change; services remain stopped. Restore $backup before rollback." >&2
	fi
	exit "$status"
}
trap rollback ERR
trap 'rollback 130' INT TERM

"${compose[@]}" exec -T database sh -lc 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$backup"
if [[ ! -s "$backup" ]]; then
	echo "Pre-deployment database backup failed" >&2
	rollback 1
fi
services_stopped=true
"${compose[@]}" stop api worker codex
if [[ -n "$new_compose" ]]; then
	install -m 0600 "$compose_file" "$compose_backup"
	install -m 0600 "$new_compose" "$compose_file"
	rm -f "$new_compose"
	compose_replaced=true
	echo "Installed the Compose file of $version ($compose_file; the previous one is $compose_backup)"
fi
schema_unchanged=false
migration_started=true
# `up --wait` returns as soon as a one-shot container is running, not when it has finished: wait for
# the migration's own exit, so the revision check below never races it (0.5.0 deployment).
if ! "${compose[@]}" up --no-build --detach --force-recreate migrate; then
	rollback 1
fi
migrate_container="$("${compose[@]}" ps --all --quiet migrate)"
migrate_exit="$(docker wait "$migrate_container")" || migrate_exit=unknown
if [[ "$migrate_exit" != 0 ]]; then
	echo "Migration exited with status $migrate_exit; see: docker logs $migrate_container" >&2
	rollback 1
fi
if ! migrated_revision="$("${compose[@]}" exec -T database sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SELECT version_num FROM alembic_version ORDER BY version_num;"')"; then
	schema_unchanged=false
	echo "Could not verify the database revision after migration" >&2
	rollback 1
fi
[[ "$migrated_revision" != "$current_revision" ]] || schema_unchanged=true
[[ "$migrated_revision" == "$target_revision" ]] || { echo "Migration did not reach $target_revision" >&2; false; }
"${compose[@]}" up -d --no-build --wait api codex
# Not a bare call: errexit would stop the script inside the function, where the ERR trap (not
# inherited without `set -E`) never runs, leaving an unhealthy version up and the worker stopped.
check_health || rollback 1
"${compose[@]}" up -d --no-build --wait worker

trap - ERR INT TERM
printf '%s\n' "$commit" > "$base/current-commit"
printf '%s\n' "$version" > "$base/current-version"
printf '%s\n' "$expected_app_id" > "$base/current-app-image-id"
printf '%s\n' "$expected_codex_id" > "$base/current-codex-image-id"
find "$base/backups" -maxdepth 1 -type f -name 'pre-*.dump' -printf '%T@ %p\n' | sort -nr | tail -n +6 | cut -d' ' -f2- | xargs -r rm -f
if [[ "$mode" == rollback ]]; then
	echo "Libris rolled back from $deployed_version to $version ($commit) on CT116 and healthy; worker restarted from persistent checkpoints"
else
	echo "Libris $version ($commit) deployed to CT116 and healthy; worker restarted from persistent checkpoints"
fi
prune_images false || echo "Warning: old Libris images could not all be removed; the deployment itself succeeded." >&2
